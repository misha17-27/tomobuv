# Если хостинг не позволяет сделать папку public/ корнем сайта (DocumentRoot),
# положите проект целиком в public_html — этот файл перенаправит запросы в public/,
# а служебные папки (app, config, storage, bin, database) закроет от доступа.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bin|config|database|docs|lang|storage|tools|vendor)(/|$) - [F,L]
    RewriteRule ^(\.git|\.env|composer\.(json|lock)) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
# Без mod_rewrite сайт не работает, но служебные папки (сессии, логи, config) всё равно закрыты
<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 403 (?i)^/(app|bin|config|database|docs|lang|storage|tools|vendor|\.git)(/|$)
    </IfModule>
</IfModule>
# Заголовки безопасности и для ответов 403 этого файла (как в public/.htaccess: только если их ещё нет — без повторов)
<IfModule mod_headers.c>
    Header always setifempty X-Content-Type-Options "nosniff" "expr=-z resp('X-Content-Type-Options')"
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin" "expr=-z resp('Referrer-Policy')"
    Header always setifempty X-Frame-Options "SAMEORIGIN" "expr=-z resp('X-Frame-Options')"
</IfModule>
